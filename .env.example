# Copy to .env (scripts) or into your framework's env file. Never commit the filled-in file.

# Themis origin. Leave as is unless Altitude tells you otherwise.
THEMIS_URL=https://themis.altitudemountainscaling.com

# This site's publishable key, starts with "thm_". From Themis -> Developers in the
# customer's workspace, or printed by scripts/provision.mjs. It can only create
# leads and read published posts.
THEMIS_API_KEY=

# Only for provisioning workspaces for your customers (scripts/provision.mjs,
# provisionAccount). Ask Altitude Mountain Scaling for a partner secret.
THEMIS_PARTNER_SECRET=
# Your agency's name, shown in the owner's welcome email.
THEMIS_PARTNER_NAME=
